.env
.env.*
!.env.example
!.env.*.example

# Node / frontend build artifacts
node_modules/
.next/
out/
dist/
build/
.turbo/
.cache/
coverage/

# Python artifacts
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Appwrite deployment packages
*.tar.gz
*.tar

# Function-local shared_py copies (canonical: src/shared_py/)
src/functions/*/shared_py/

# Function-local dependency vendor trees are unsupported; use requirements.txt
src/functions/*/lib/

# Temporary folders
.package-temp/
dev/.tmp/
dev/.ci-logs/
tmp-*/
tmp-test-analysis/
mcp/chatgpt-ops/.railway-workdir/

# Generated reports
diagnostic-report.json
report.json
test-results.json

.verification/
!packages/verification-controller/controller-repository-seed/a1-oci/workspace-parent/artifacts/.verification/
!packages/verification-controller/controller-repository-seed/a1-oci/workspace-parent/artifacts/.verification/artifacts/
