{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://salmora.local/schemas/verification-manifest.v2.schema.json",
  "title": "Portable verification registry v2",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "groups",
    "globalPaths",
    "prosePatterns",
    "ignoredPaths",
    "suites",
    "sqlInventory",
    "exclusions",
    "alwaysSuiteIds"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "kind": {
      "const": "portable-verification-registry"
    },
    "groups": {
      "const": [
        "web",
        "python",
        "mcp",
        "quick",
        "portable",
        "windows"
      ]
    },
    "globalPaths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "prosePatterns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "ignoredPaths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "suites": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "group",
          "owner",
          "paths",
          "consumers",
          "command",
          "capabilities",
          "collection",
          "expectedSkips",
          "timeoutMs",
          "ci",
          "profiles",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "group": {
            "enum": [
              "web",
              "python",
              "mcp",
              "quick",
              "portable",
              "windows"
            ]
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "consumers": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "command": {
            "type": "object",
            "required": [
              "executable",
              "args"
            ],
            "additionalProperties": false,
            "properties": {
              "executable": {
                "type": "string",
                "minLength": 1
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "cwd": {
                "type": "string",
                "minLength": 1
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            }
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "collection": {
            "type": "object",
            "required": [
              "format",
              "minimumTests",
              "required"
            ],
            "additionalProperties": false,
            "properties": {
              "format": {
                "enum": [
                  "node-tap",
                  "pytest-junit",
                  "operator-json",
                  "exit-code"
                ]
              },
              "minimumTests": {
                "type": "integer",
                "minimum": 0
              },
              "required": {
                "const": true
              },
              "reportPath": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "expectedSkips": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "reason",
                "pattern"
              ],
              "additionalProperties": false,
              "properties": {
                "reason": {
                  "type": "string",
                  "minLength": 1
                },
                "pattern": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 1
          },
          "ci": {
            "type": "boolean"
          },
          "profiles": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "changes",
                "repository"
              ]
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "nativeTargets": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "nativeExclude": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        }
      }
    },
    "sqlInventory": {
      "type": "object",
      "required": [
        "root",
        "files",
        "offlineFiles",
        "exceptionTargets",
        "nativeDefaultSuite"
      ],
      "additionalProperties": false,
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "offlineFiles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "exceptionTargets": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "nativeDefaultSuite": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "exclusions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "pattern",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "pattern": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "alwaysSuiteIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
