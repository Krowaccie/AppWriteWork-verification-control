{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.appwritework.dev/verification/controller-bundle.v2.schema.json",
  "title": "Protected verification controller bundle manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sourceRepository", "sourceRepositoryRevision", "controllerRepository", "controllerRevision", "entrypoints", "files", "schemaDigests", "trustMaterials", "provenance"],
  "properties": {
    "schemaVersion": { "const": "controller-bundle.v2" },
    "sourceRepository": { "const": "Krowaccie/AppWriteWork" },
    "sourceRepositoryRevision": { "$ref": "#/$defs/revision" },
    "controllerRepository": { "const": "Krowaccie/AppWriteWork-verification-control" },
    "controllerRevision": { "$ref": "#/$defs/revision" },
    "entrypoints": { "$ref": "#/$defs/files" },
    "files": { "$ref": "#/$defs/files" },
    "schemaDigests": { "$ref": "#/$defs/files" },
    "trustMaterials": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        { "$ref": "#/$defs/evaluator" },
        { "$ref": "#/$defs/evidenceValidator" },
        { "$ref": "#/$defs/networkPolicy" },
        { "$ref": "#/$defs/transcriptCorpus" }
      ],
      "items": false
    },
    "provenance": { "$ref": "#/$defs/file" }
  },
  "$defs": {
    "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "path": { "type": "string", "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$" },
    "file": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": { "path": { "$ref": "#/$defs/path" }, "sha256": { "$ref": "#/$defs/digest" } }
    },
    "files": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/file" } },
    "trust": {
      "type": "object", "additionalProperties": false, "required": ["kind", "path", "sha256"],
      "properties": { "kind": { "type": "string" }, "path": { "$ref": "#/$defs/path" }, "sha256": { "$ref": "#/$defs/digest" } }
    },
    "evaluator": { "allOf": [{ "$ref": "#/$defs/trust" }, { "properties": { "kind": { "const": "evaluator" } } }] },
    "evidenceValidator": { "allOf": [{ "$ref": "#/$defs/trust" }, { "properties": { "kind": { "const": "evidenceValidator" } } }] },
    "networkPolicy": { "allOf": [{ "$ref": "#/$defs/trust" }, { "properties": { "kind": { "const": "networkPolicy" } } }] },
    "transcriptCorpus": { "allOf": [{ "$ref": "#/$defs/trust" }, { "properties": { "kind": { "const": "transcriptCorpus" } } }] }
  }
}
