{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.appwritework.dev/verification/controller-bundle-proposal.v2.schema.json",
  "title": "Non-promotable controller bundle proposal v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "proposalStatus", "sourceRepository", "sourceRepositoryRevision", "controllerRepository", "controllerRevision", "seedSourceSets", "entrypoints", "files", "schemaDigests", "trustMaterials", "provenance"],
  "properties": {
    "schemaVersion": { "const": "controller-bundle.proposal.v2" },
    "proposalStatus": { "const": "BLOCKED_UNMATERIALIZED" },
    "sourceRepository": { "const": "Krowaccie/AppWriteWork" },
    "sourceRepositoryRevision": { "const": "UNMATERIALIZED" },
    "controllerRepository": { "const": "Krowaccie/AppWriteWork-verification-control" },
    "controllerRevision": { "const": "UNMATERIALIZED" },
    "seedSourceSets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "path", "schemaPath"],
      "properties": {
        "schemaVersion": { "const": "controller-seed-source-sets-reference.v1" },
        "path": { "const": "packages/verification-controller/controller-seed-source-sets.v1.json" },
        "schemaPath": { "const": "dev/verification/schemas/controller-seed-source-sets.v1.schema.json" }
      }
    },
    "entrypoints": { "$ref": "#/$defs/files" },
    "files": { "$ref": "#/$defs/files" },
    "schemaDigests": { "$ref": "#/$defs/files" },
    "trustMaterials": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "prefixItems": [
        { "$ref": "#/$defs/evaluator" }, { "$ref": "#/$defs/evidenceValidator" },
        { "$ref": "#/$defs/networkPolicy" }, { "$ref": "#/$defs/transcriptCorpus" }
      ], "items": false
    },
    "provenance": { "$ref": "#/$defs/file" }
  },
  "$defs": {
    "path": { "type": "string", "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$" },
    "file": { "type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": { "path": { "$ref": "#/$defs/path" }, "sha256": { "const": "UNMATERIALIZED" } } },
    "files": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/file" } },
    "trust": { "type": "object", "additionalProperties": false, "required": ["kind", "path", "sha256"], "properties": { "kind": { "type": "string" }, "path": { "$ref": "#/$defs/path" }, "sha256": { "const": "UNMATERIALIZED" } } },
    "evaluator": { "allOf": [{ "$ref": "#/$defs/trust" }, { "properties": { "kind": { "const": "evaluator" } } }] },
    "evidenceValidator": { "allOf": [{ "$ref": "#/$defs/trust" }, { "properties": { "kind": { "const": "evidenceValidator" } } }] },
    "networkPolicy": { "allOf": [{ "$ref": "#/$defs/trust" }, { "properties": { "kind": { "const": "networkPolicy" } } }] },
    "transcriptCorpus": { "allOf": [{ "$ref": "#/$defs/trust" }, { "properties": { "kind": { "const": "transcriptCorpus" } } }] }
  }
}
