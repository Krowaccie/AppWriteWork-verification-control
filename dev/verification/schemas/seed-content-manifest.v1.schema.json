{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "seed-content-manifest.v1",
  "type": "object", "additionalProperties": false, "required": ["schemaVersion", "sourceRepositoryRevision", "files", "closureDigest", "workflowMappings", "a1SupervisorEvidence"],
  "properties": {
    "schemaVersion": { "const": "seed-content-manifest.v1" }, "sourceRepositoryRevision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "files": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/file" }, "not": { "contains": { "type": "object", "properties": { "path": { "const": "seed-content-manifest.v1.json" } }, "required": ["path"] } } },
    "closureDigest": { "$ref": "#/$defs/digest" },
    "workflowMappings": { "type": "array", "minItems": 7, "maxItems": 7, "prefixItems": [{ "$ref": "#/$defs/collectMapping" }, { "$ref": "#/$defs/controllerValidationMapping" }, { "$ref": "#/$defs/productionReadonlyMapping" }, { "$ref": "#/$defs/publishMapping" }, { "$ref": "#/$defs/recoverMapping" }, { "$ref": "#/$defs/releaseProductionMapping" }, { "$ref": "#/$defs/verifyMapping" }], "items": false },
    "a1SupervisorEvidence": { "$ref": "#/$defs/a1Evidence" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "file": { "type": "object", "additionalProperties": false, "required": ["path", "mode", "sha256", "owner"], "properties": { "path": { "type": "string", "minLength": 1 }, "mode": { "enum": ["100644", "100755"] }, "sha256": { "$ref": "#/$defs/digest" }, "owner": { "enum": ["overlay", "controller", "tooling", "validation-only", "a1-supervisor"] } } },
    "mapping": { "type": "object", "additionalProperties": false, "required": ["source", "destination"], "properties": { "source": { "type": "string" }, "destination": { "type": "string" } } },
    "collectMapping": { "allOf": [{ "$ref": "#/$defs/mapping" }, { "properties": { "source": { "const": "packages/verification-controller/workflows/collect-appwrite-test-readback.yml" }, "destination": { "const": ".github/workflows/collect-appwrite-test-readback.yml" } } }] },
    "controllerValidationMapping": { "allOf": [{ "$ref": "#/$defs/mapping" }, { "properties": { "source": { "const": "packages/verification-controller/workflows/controller-validation.yml" }, "destination": { "const": ".github/workflows/controller-validation.yml" } } }] },
    "productionReadonlyMapping": { "allOf": [{ "$ref": "#/$defs/mapping" }, { "properties": { "source": { "const": "packages/verification-controller/workflows/production-readonly.yml" }, "destination": { "const": ".github/workflows/production-readonly.yml" } } }] },
    "publishMapping": { "allOf": [{ "$ref": "#/$defs/mapping" }, { "properties": { "source": { "const": "packages/verification-controller/workflows/publish-controller-bundle.yml" }, "destination": { "const": ".github/workflows/publish-controller-bundle.yml" } } }] },
    "recoverMapping": { "allOf": [{ "$ref": "#/$defs/mapping" }, { "properties": { "source": { "const": "packages/verification-controller/workflows/recover-appwrite-test.yml" }, "destination": { "const": ".github/workflows/recover-appwrite-test.yml" } } }] },
    "releaseProductionMapping": { "allOf": [{ "$ref": "#/$defs/mapping" }, { "properties": { "source": { "const": "packages/verification-controller/workflows/release-production.yml" }, "destination": { "const": ".github/workflows/release-production.yml" } } }] },
    "verifyMapping": { "allOf": [{ "$ref": "#/$defs/mapping" }, { "properties": { "source": { "const": "packages/verification-controller/workflows/verify-test-cloud.yml" }, "destination": { "const": ".github/workflows/verify-test-cloud.yml" } } }] },
    "a1Evidence": { "type": "object", "additionalProperties": false, "required": ["descriptorDigest", "sourceTreeDigest", "binaryDigest"], "properties": { "descriptorDigest": { "const": "sha256:3f6fd8bc74e3507bb2fe9f9a5dceeca33690f900539830a16cf37949d159e776" }, "sourceTreeDigest": { "const": "sha256:00bda078134e863f46684e1da0deb9a7f123161f965f7a979cd1f0310afa6d54" }, "binaryDigest": { "const": "sha256:0b52f5b1f0abdf0acbd4d10c1a4895b53401d5644161ad71460b50317d5e1d89" } } }
  }
}
