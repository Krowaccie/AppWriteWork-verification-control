        "endpoint": {
          "const": "https://api.salmora.net/v1"
        },
        "projectId": {
          "const": "69eb4818000afa64a7fa"
        },
        "siteId": {
          "const": "69eb4a020024c520642e"
        },
        "publicOrigin": {
          "const": "https://salmora.net"
        }
      }
    },
    "credentialVariables": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "readonly",
        "forbiddenReleaseVariableName",
        "forbiddenGenericVariableName"
      ],
      "properties": {
        "readonly": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "credentialClass",
            "variableName",
            "scopes"
          ],
          "properties": {
            "credentialClass": {
              "const": "production-readonly"
            },
            "variableName": {
              "const": "APPWRITE_PRODUCTION_READONLY_API_KEY"
            },
            "scopes": {
              "const": [
                "functions.read",
                "sites.read"
              ]
            }
          }
        },
        "forbiddenReleaseVariableName": {
          "const": "APPWRITE_PRODUCTION_RELEASE_API_KEY"
        },
        "forbiddenGenericVariableName": {
          "const": "APPWRITE_API_KEY"
        }
      }
    },
    "site": {
