  "$defs": {
    "functionRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entrypoint",
        "functionId",
        "logicalId",
        "runtime",
        "sourcePath"
      ],
      "properties": {
        "entrypoint": {
          "const": "main.py"
        },
        "functionId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "logicalId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*-py$"
        },
        "runtime": {
          "const": "python-3.12"
        },
        "sourcePath": {
          "type": "string",
          "pattern": "^src/functions/[a-z0-9][a-z0-9-]*-py$"
        }
      }
    }
