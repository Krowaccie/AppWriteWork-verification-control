      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "gitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactLogicalTarget",
        "deploymentLogicalTarget",
        "kind",
        "deploymentId",
        "canonicalContentDigest",
        "transportDigest"
      ],
      "properties": {
        "artifactLogicalTarget": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "deploymentLogicalTarget": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "kind": {
          "enum": [
            "site",
            "function"
          ]
        },
        "deploymentId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{7,63}$"
        },
        "canonicalContentDigest": {
          "$ref": "#/$defs/digest"
        },
        "transportDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    }
