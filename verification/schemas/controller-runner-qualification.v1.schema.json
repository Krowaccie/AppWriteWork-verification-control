{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "controller-runner-qualification.v1",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "workflowRunId", "workflowHeadSha", "controllerRepository", "sourceRepository", "sourceRepositoryRevision", "controllerRevision", "runnerRevision", "runnerImage", "setupBindings", "jobObjectQualification"],
  "properties": {
    "schemaVersion": { "const": "controller-runner-qualification.v1" },
    "workflowRunId": { "type": "string", "pattern": "^[1-9][0-9]{0,19}$" },
    "workflowHeadSha": { "$ref": "#/$defs/revision" },
    "controllerRepository": { "const": "Krowaccie/AppWriteWork-verification-control" },
    "sourceRepository": { "const": "Krowaccie/AppWriteWork" },
    "sourceRepositoryRevision": { "$ref": "#/$defs/revision" },
    "controllerRevision": { "$ref": "#/$defs/revision" },
    "runnerRevision": { "$ref": "#/$defs/revision" },
    "runnerImage": { "const": "windows-2025" },
    "setupBindings": { "type": "object", "additionalProperties": false, "required": ["testCloudSetupReadbackJsonDigest", "testCloudSetupReadbackDigest", "testCloudSetupAttestationJsonDigest", "testCloudSetupAttestationDigest"], "properties": { "testCloudSetupReadbackJsonDigest": { "$ref": "#/$defs/digest" }, "testCloudSetupReadbackDigest": { "$ref": "#/$defs/digest" }, "testCloudSetupAttestationJsonDigest": { "$ref": "#/$defs/digest" }, "testCloudSetupAttestationDigest": { "$ref": "#/$defs/digest" } } },
    "jobObjectQualification": { "type": "object", "additionalProperties": false, "required": ["schemaVersion", "status", "killOnJobClose", "breakawayDisabled"], "properties": { "schemaVersion": { "const": "windows-job-object-qualification.v1" }, "status": { "const": "PASS" }, "killOnJobClose": { "const": true }, "breakawayDisabled": { "const": true } } }
  },
  "$defs": { "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" }, "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" } }
}
