{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "seed-content-manifest.v1",
  "type": "object", "additionalProperties": false, "required": ["schemaVersion", "sourceRepositoryRevision", "files", "closureDigest", "workflowMappings", "a1SupervisorEvidence"],
  "properties": {
    "schemaVersion": { "const": "seed-content-manifest.v1" }, "sourceRepositoryRevision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "files": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/file" }, "not": { "contains": { "type": "object", "properties": { "path": { "const": "seed-content-manifest.v1.json" } }, "required": ["path"] } } },
    "closureDigest": { "$ref": "#/$defs/digest" },
    "workflowMappings": { "type": "array", "minItems": 7, "maxItems": 7, "prefixItems": [{ "$ref": "#/$defs/collectMapping" }, { "$ref": "#/$defs/controllerValidationMapping" }, { "$ref": "#/$defs/productionReadonlyMapping" }, { "$ref": "#/$defs/publishMapping" }, { "$ref": "#/$defs/recoverMapping" }, { "$ref": "#/$defs/releaseProductionMapping" }, { "$ref": "#/$defs/verifyMapping" }], "items": false },
    "a1SupervisorEvidence": { "$ref": "#/$defs/a1Evidence" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "file": { "type": "object", "additionalProperties": false, "required": ["path", "mode", "sha256", "owner"], "properties": { "path": { "type": "string", "minLength": 1 }, "mode": { "enum": ["100644", "100755"] }, "sha256": { "$ref": "#/$defs/digest" }, "owner": { "enum": ["overlay", "controller", "tooling", "validation-only", "a1-supervisor"] } } },
    "mapping": { "type": "object", "additionalProperties": false, "required": ["source", "destination"], "properties": { "source": { "type": "string" }, "destination": { "type": "string" } } },
    "collectMapping": { "allOf": [{ "$ref": "#/$defs/mapping" }, { "properties": { "source": { "const": "verification/controller/workflows/collect-appwrite-test-readback.yml" }, "destination": { "const": ".github/workflows/collect-appwrite-test-readback.yml" } } }] },
    "controllerValidationMapping": { "allOf": [{ "$ref": "#/$defs/mapping" }, { "properties": { "source": { "const": "verification/controller/workflows/controller-validation.yml" }, "destination": { "const": ".github/workflows/controller-validation.yml" } } }] },
    "productionReadonlyMapping": { "allOf": [{ "$ref": "#/$defs/mapping" }, { "properties": { "source": { "const": "verification/controller/workflows/production-readonly.yml" }, "destination": { "const": ".github/workflows/production-readonly.yml" } } }] },
    "publishMapping": { "allOf": [{ "$ref": "#/$defs/mapping" }, { "properties": { "source": { "const": "verification/controller/workflows/publish-controller-bundle.yml" }, "destination": { "const": ".github/workflows/publish-controller-bundle.yml" } } }] },
    "recoverMapping": { "allOf": [{ "$ref": "#/$defs/mapping" }, { "properties": { "source": { "const": "verification/controller/workflows/recover-appwrite-test.yml" }, "destination": { "const": ".github/workflows/recover-appwrite-test.yml" } } }] },
    "releaseProductionMapping": { "allOf": [{ "$ref": "#/$defs/mapping" }, { "properties": { "source": { "const": "verification/controller/workflows/release-production.yml" }, "destination": { "const": ".github/workflows/release-production.yml" } } }] },
    "verifyMapping": { "allOf": [{ "$ref": "#/$defs/mapping" }, { "properties": { "source": { "const": "verification/controller/workflows/verify-test-cloud.yml" }, "destination": { "const": ".github/workflows/verify-test-cloud.yml" } } }] },
    "a1Evidence": { "type": "object", "additionalProperties": false, "required": ["descriptorDigest", "sourceTreeDigest", "binaryDigest"], "properties": { "descriptorDigest": { "const": "sha256:fce848aa1d385b6062867774c4233a41b5b938dcad0fd430d422479fe295f029" }, "sourceTreeDigest": { "const": "sha256:db8e5d3c94b393e5cf7bd5d50d3c859fc0c22d2a39306329b26532c7f5dc4ab7" }, "binaryDigest": { "const": "sha256:ac39ee61645f83cf5d72eec706cd03c1c8d89be4236dec9035d617330363c0b0" } } }
  }
}
