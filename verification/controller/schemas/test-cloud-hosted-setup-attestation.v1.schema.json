{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "test-cloud-hosted-setup-attestation.v1.schema.json",
  "title": "Closed hosted test-cloud setup attestation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "providerSetupReadbackDigest",
    "hostedSetupReadbackDigest",
    "executionObservationPolicyDigest",
    "primaryExecutionRetentionMaxSeconds",
    "issuedAtEpochSeconds",
    "expiresAtEpochSeconds"
  ],
  "properties": {
    "schemaVersion": { "const": "test-cloud.hosted-setup-attestation.v1" },
    "providerSetupReadbackDigest": { "$ref": "#/$defs/digest" },
    "hostedSetupReadbackDigest": { "$ref": "#/$defs/digest" },
    "executionObservationPolicyDigest": { "$ref": "#/$defs/digest" },
    "primaryExecutionRetentionMaxSeconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400
    },
    "issuedAtEpochSeconds": { "type": "integer", "minimum": 0 },
    "expiresAtEpochSeconds": { "type": "integer", "minimum": 1 }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
